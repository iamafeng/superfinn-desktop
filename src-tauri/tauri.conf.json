{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "superFinn",
  "version": "0.1.0",
  "identifier": "io.superfinn.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "superfinn",
      "iconPath": "icons/32x32.png",
      "tooltip": "superFinn"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
